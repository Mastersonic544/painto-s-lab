# Firebase web app settings (browser; also set on Vercel)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Firebase service account (server only; set on Vercel and converter host)
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Local-only alternative to the two credential fields above:
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# Cloudinary media settings, used by browser and converter
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Dedicated converter service. Use the same secret on Vercel and converter host.
CONVERTER_URL=
CONVERTER_SECRET=

# Optional AI complexity rating; the app has a local fallback.
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
