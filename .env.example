# Supabase — client-side (exposed in the browser bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase — server-only (Vercel serverless functions in /api). Never expose.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter — server-only. Used by the complexity/color-count decision.
OPENROUTER_API_KEY=
# Free vision model on OpenRouter (PRD §4: "free NVIDIA-class vision model").
# Override if the default is deprecated. The algorithmic fallback covers any
# model failure so this isn't a hard dependency.
OPENROUTER_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free
