# Supabase — client-side (exposed in the browser bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase — server-only (Vercel serverless functions in /api). Never expose.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Converter backend (Render). When CONVERTER_URL is set, /api/generate
# forwards jobs to the long-running Render service instead of running the
# engine inline (which would hit the serverless timeout). Leave CONVERTER_URL
# blank locally to run the engine inline via the Vite dev bridge.
# CONVERTER_SECRET is a shared secret; set the SAME value on Vercel and Render.
CONVERTER_URL=
CONVERTER_SECRET=

# OpenRouter — server-only. Used by the complexity/color-count decision.
OPENROUTER_API_KEY=
# Free vision model on OpenRouter (PRD §4: "free NVIDIA-class vision model").
# Override if the default is deprecated. The algorithmic fallback covers any
# model failure so this isn't a hard dependency.
OPENROUTER_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free
